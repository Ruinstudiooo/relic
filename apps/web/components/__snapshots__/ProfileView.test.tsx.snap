exports[`ProfileView > matches snapshot for full profile 1`] = `
<div>
  <div
    class="card"
  >
    <img
      alt=""
      class="avatar"
      height="96"
      src="https://example.com/avatar.png"
      width="96"
    />
    <div>
      <h1
        class="name"
      >
        Romeo
      </h1>
      <p
        class="status"
      >
        <span
          aria-hidden="true"
          class="dot"
        />
        Active building
      </p>
    </div>
    <p
      class="bio"
    >
      Full profile with custom theme and multiple socials
    </p>
    <nav
      aria-label="links"
      class="links"
    >
      <a
        class="link link--highlight"
        href="https://github.com/RomeoXLover"
        rel="noopener noreferrer nofollow"
        target="_blank"
      >
        <span>
          <span
            aria-hidden="true"
          >
            ●
             
          </span>
          github
        </span>
        <span
          aria-hidden="true"
          class="link-arrow"
        >
          →
        </span>
      </a>
      <a
        class="link"
        href="https://x.com/romeo"
        rel="noopener noreferrer nofollow"
        target="_blank"
      >
        <span>
          <span
            aria-hidden="true"
          >
            ✕
             
          </span>
          x
        </span>
        <span
          aria-hidden="true"
          class="link-arrow"
        >
          →
        </span>
      </a>
      <a
        class="link"
        href="https://discord.gg/relic"
        rel="noopener noreferrer nofollow"
        target="_blank"
      >
        <span>
          <span
            aria-hidden="true"
          >
            ◈
             
          </span>
          discord
        </span>
        <span
          aria-hidden="true"
          class="link-arrow"
        >
          →
        </span>
      </a>
      <a
        class="link"
        href="https://spotify.com/artist/romeo"
        rel="noopener noreferrer nofollow"
        target="_blank"
      >
        <span>
          <span
            aria-hidden="true"
          >
            ♫
             
          </span>
          spotify
        </span>
        <span
          aria-hidden="true"
          class="link-arrow"
        >
          →
        </span>
      </a>
      <a
        class="link"
        href="https://example.com"
        rel="noopener noreferrer nofollow"
        target="_blank"
      >
        <span>
          <span
            aria-hidden="true"
          >
            ↗
             
          </span>
          website
        </span>
        <span
          aria-hidden="true"
          class="link-arrow"
        >
          →
        </span>
      </a>
    </nav>
  </div>
</div>
